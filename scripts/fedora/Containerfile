# Fedora-based VectorCraft image, for Podman (Fedora's default container tool).
#
#   podman build -f scripts/fedora/Containerfile -t vectorcraft:fedora .
#   podman run --rm -it -v "$PWD":/work:Z vectorcraft:fedora python
ARG FEDORA_VERSION=42
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

RUN dnf install -y python3 python3-pip python3-devel gcc gcc-c++ git \
    && dnf clean all

COPY . /opt/vectorcraft-src
RUN python3 -m venv /opt/vectorcraft \
    && /opt/vectorcraft/bin/pip install --no-cache-dir --upgrade pip wheel \
    && /opt/vectorcraft/bin/pip install --no-cache-dir /opt/vectorcraft-src faiss-cpu \
    && rm -rf /opt/vectorcraft-src

ENV PATH="/opt/vectorcraft/bin:${PATH}"
WORKDIR /work
CMD ["python"]
